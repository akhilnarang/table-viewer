{
  // Cloudflare Worker config. Deploy with: npx wrangler deploy
  // Pages projects do not use this file. They use functions/proxy.js and the public/ directory.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "table-viewer",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
